Date: Thu, 20 Aug 2026 00:17:09 +0200
Subject: popupMenu: Clear the active menu item when it's destroyed

The active menu item is tracked in PopupMenuBase._activeMenuItem, and
for items living inside PopupMenuSection instances this reference is
propagated to the parent menu by _subMenuActiveChanged.
When a menu such as the authMenu is rebuilt while an item is being
activated, the active item is destroyed without _activeMenuItem being
cleared, so a later close() ends up dereferencing a disposed object.

Clear _activeMenuItem from a destroy handler connected on the item, so
the reference is dropped as soon as the item is disposed.
---
 js/ui/popupMenu.js | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/js/ui/popupMenu.js b/js/ui/popupMenu.js
index 1d85891..32eb357 100644
--- a/js/ui/popupMenu.js
+++ b/js/ui/popupMenu.js
@@ -753,7 +753,14 @@ export class PopupMenuBase extends Signals.EventEmitter {
 
         if (this._activeMenuItem)
             this._activeMenuItem.active = false;
+
         this._activeMenuItem = submenuItem;
+
+        submenuItem?.connectObject('destroy', () => {
+            if (this._activeMenuItem === submenuItem)
+                this._activeMenuItem = null;
+        }, this);
+
         this.emit('active-changed', submenuItem);
     }
 
