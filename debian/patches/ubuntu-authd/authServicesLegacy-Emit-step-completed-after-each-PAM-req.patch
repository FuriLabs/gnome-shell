@@ -86,6 +95,7 @@ export class AuthServicesLegacy extends AuthServices {
 
         this._userVerifier.call_answer_query(
             serviceName, answer, this._cancellable).catch(logErrorUnlessCancelled);
+        this._pendingSteps.add(serviceName);
     }
 
