 js/gdm/authServices.js               | 21 ++++++++++++++++-----
 js/gdm/authServicesLegacy.js         | 21 +++++++++++----------
 js/gdm/authServicesSSSDSwitchable.js | 20 ++++++++++++++------
 js/gdm/loginDialog.js                |  2 +-
 js/ui/unlockDialog.js                |  2 +-
 5 files changed, 43 insertions(+), 23 deletions(-)

diff --git a/js/gdm/authServices.js b/js/gdm/authServices.js
index 51a35da..79e19bb 100644
--- a/js/gdm/authServices.js
+++ b/js/gdm/authServices.js
@@ -171,6 +171,22 @@ export class AuthServices extends GObject.Object {
         return this._enabledMechanisms?.filter(m => m.ready !== false);
     }
 
+    _setEnabledMechanisms(mechanisms) {
+        this._enabledMechanisms = mechanisms?.map(m => {
+            const mechanism = {
+                ...m,
+                ...RoleProperties[m.role],
+            };
+
+            Object.defineProperty(mechanism, 'equals', {
+                value: other => this._mechanismEquals(mechanism, other),
+                enumerable: true,
+            });
+
+            return mechanism;
+        });
+    }
+
     get _roleToService() {
         return this.constructor.RoleToService;
     }
@@ -290,14 +306,9 @@ export class AuthServices extends GObject.Object {
 
     _updateEnabledMechanisms() {
         const selectedMechanism = this._selectedMechanism;
-        this._enabledMechanisms = [];
 
         this._handleUpdateEnabledMechanisms();
 
-        this._enabledMechanisms = this._enabledMechanisms.map(m => ({
-            ...m,
-            ...RoleProperties[m.role],
-        }));
         this._selectedMechanism = this._enabledMechanisms.find(mechanism =>
             this._mechanismEquals(mechanism, selectedMechanism));
 
