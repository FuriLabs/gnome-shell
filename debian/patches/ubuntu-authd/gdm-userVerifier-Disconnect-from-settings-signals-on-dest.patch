From: =?utf-8?b?Ik1hcmNvIFRyZXZpc2FuIChUcmV2acOxbyki?= <mail@3v1n0.net>
Date: Thu, 20 Aug 2026 02:55:18 +0200
Subject: gdm/userVerifier: Disconnect from settings signals on destroy

Also drop the manual disposal of the settings object
---
 js/gdm/userVerifier.js | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/js/gdm/userVerifier.js b/js/gdm/userVerifier.js
index ffd85d8..7713a2c 100644
--- a/js/gdm/userVerifier.js
+++ b/js/gdm/userVerifier.js
@@ -68,7 +68,7 @@ export class ShellUserVerifier extends Signals.EventEmitter {
         this._messageQueueTimeoutId = 0;
 
         this._settings = new Gio.Settings({schema_id: LOGIN_SCREEN_SCHEMA});
-        this._settings.connect('changed', () => this._onSettingsChanged());
+        this._settings.connectObject('changed', () => this._onSettingsChanged(), this);
         this._updateAuthServices();
     }
 
@@ -190,7 +190,6 @@ export class ShellUserVerifier extends Signals.EventEmitter {
 
         this.cancel();
 
-        this._settings.run_dispose();
         this._settings = null;
     }
 
