     BrokerSelection: 'authd-broker-selection',
     AuthModeSelection: 'authd-auth-mode-selection',
@@ -89,6 +91,10 @@ export class AuthServicesAuthd extends AuthServices {
         [AuthdRoles.WebLogin]: SERVICE_NAME,
     };
 
+    static isEnabled(_settings, ubuntuSettings) {
+        return ubuntuSettings.get_boolean(AUTHD_AUTHENTICATION_KEY);
+    }
+
     constructor(params) {
         super(params);
         this._brokers = {};
