 js/gdm/authPrompt.js   | 11 +++++++++++
 js/gdm/authServices.js |  5 +++++
 js/gdm/userVerifier.js |  1 +
 3 files changed, 17 insertions(+)

diff --git a/js/gdm/authPrompt.js b/js/gdm/authPrompt.js
index 57349ce..5a31f6e 100644
--- a/js/gdm/authPrompt.js
+++ b/js/gdm/authPrompt.js
@@ -190,6 +190,7 @@ export const AuthPrompt = GObject.registerClass({
             'web-login', (_, args) => this._onWebLogin(args),
             'verification-failed', (_, args) => this._onVerificationFailed(args),
             'verification-complete', () => this._onVerificationComplete(),
+            'step-completed', (_, args) => this._onStepCompleted(args),
             'reset', (_, args) => this._onReset(args),
             this);
 
@@ -467,6 +468,16 @@ export const AuthPrompt = GObject.registerClass({
         this.emit('next');
     }
 
+    _onStepCompleted({serviceName}) {
+        if (this._queryingService !== serviceName)
+            return;
+
+        if (this.verificationStatus === AuthPromptStatus.VERIFICATION_IN_PROGRESS) {
+            this.verificationStatus = AuthPromptStatus.VERIFYING;
+            this.stopSpinning();
+        }
+    }
+
     updateEntry(secret) {
         let newEntry, inactiveEntry;
 
diff --git a/js/gdm/authServices.js b/js/gdm/authServices.js
index 5bdc929..09ab2e5 100644
--- a/js/gdm/authServices.js
+++ b/js/gdm/authServices.js
@@ -85,6 +85,11 @@ export class AuthServices extends GObject.Object {
          */
         'ask-question': {param_types: [GObject.TYPE_JSOBJECT]},
         /**
+         * @param {string} serviceName
+         */
+        'step-completed': {param_types: [GObject.TYPE_JSOBJECT]},
+        /**
+         * @param {string} serviceName
          * @param {boolean} [softReset]
          * @param {boolean} [reuseEntryText]
          */
diff --git a/js/gdm/userVerifier.js b/js/gdm/userVerifier.js
index 53dd3f1..7732b8e 100644
--- a/js/gdm/userVerifier.js
+++ b/js/gdm/userVerifier.js
@@ -417,6 +417,7 @@ export class ShellUserVerifier extends Signals.EventEmitter {
                 'reset', (_, args) => this.emit('reset', args),
                 'show-choice-list', (_, args) => this.emit('show-choice-list', args),
                 'show-button', (_, args) => this.emit('show-button', args),
+                'step-completed', (_, args) => this.emit('step-completed', args),
                 'mechanisms-changed', () => this._onMechanismsChanged().catch(logError),
                 'web-login', (_, args) => this.emit('web-login', args),
                 this);
