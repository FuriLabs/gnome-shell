@@ -707,7 +718,8 @@ export const LoginDialog = GObject.registerClass({
         const centerX = dialogBox.x1 + (dialogBox.x2 - dialogBox.x1) / 2;
 
         actorBox.x1 = Math.floor(centerX - natWidth / 2);
-        actorBox.y1 = dialogBox.y2 - natHeight;
+        actorBox.y1 = Math.floor((dialogBox.y2 - natHeight) *
+                                 this._logoBinNormalizedY);
         actorBox.x2 = actorBox.x1 + natWidth;
         actorBox.y2 = actorBox.y1 + natHeight;
 
@@ -1036,6 +1048,30 @@ export const LoginDialog = GObject.registerClass({
         this._updateLogoTexture(this._textureCache, this._logoFile);
     }
 
+    _getPlymouthScale(monitor) {
+        if (!monitor)
+            return 1;
+
+        // Convert logical dimensions back to physical so we get the same
+        // reasoning as Plymouth
+        let width = monitor.width * monitor.geometry_scale;
+        let height = monitor.height * monitor.geometry_scale;
+
+        // This should match Plymouth's algorithm in ply-utils.c
+        if (height > width) {
+           const tmp = width;
+           width = height;
+           height = tmp;
+        }
+
+        const aspect = width / height;
+        if (aspect == 1.5) {
+            return (width >= 1800 && height >= 1200) ? 2 : 1;
+        }
+
+        return (width >= 2880 && height >= 1620) ? 2 : 1;
+    }
+
     _onPrompted() {
