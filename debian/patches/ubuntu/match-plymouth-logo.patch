         this._a11yMenuButton = new A11yMenuButton();
         this._bottomButtonGroup.add_child(this._a11yMenuButton);
 
+        const plymouthWatermarkVerticalAlignment = 0.96;
+        this._logoBinNormalizedY = plymouthWatermarkVerticalAlignment;
