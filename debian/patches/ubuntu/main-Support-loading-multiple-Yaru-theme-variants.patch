       g_object_notify_by_pspec (G_OBJECT (settings), props[PROP_FONT_NAME]);
     }
+  else if (g_str_equal (key, KEY_GTK_THEME))
+    {
+      update_theme_settings (settings);
+    }
   else if (g_str_equal (key, KEY_GTK_ICON_THEME))
