+    St.Settings.get().connect('notify::shell-color-scheme', _loadDefaultStylesheet);
+    St.Settings.get().connect('notify::accent-color', _loadDefaultStylesheet);
 
     // Initialize ParentalControlsManager before the UI
     ParentalControlsManager.getDefault();
@@ -473,6 +476,48 @@ export function getStyleVariant() {
     }
 }
 
+export function getYaruVariantFromAccent() {
+    switch (St.Settings.get().accentColor) {
+    case St.SystemAccentColor.BLUE:
+      return "blue";
+    case St.SystemAccentColor.TEAL:
+      return "prussiangreen";
+    case St.SystemAccentColor.GREEN:
+      return "olive";
+    case St.SystemAccentColor.YELLOW:
+      return "yellow";
+    case St.SystemAccentColor.ORANGE:
+      return "default";
+    case St.SystemAccentColor.RED:
+      return "red";
+    case St.SystemAccentColor.PINK:
+      return "magenta";
+    case St.SystemAccentColor.PURPLE:
+      return "purple";
+    case St.SystemAccentColor.SLATE:
+      return "sage";
+  }
+}
+
+function _getYaruStyleSheet() {
+    const { shellColorScheme } = St.Settings.get();
+    const styleVariant = shellColorScheme !== 'default' ?
+        shellColorScheme.replace('prefer-', '') : getStyleVariant() || 'light';
+    const isDark = styleVariant === 'dark';
+    const baseThemeName = sessionMode.stylesheetName.split(".css").at(0);
+    let colorSchemeVariant = getYaruVariantFromAccent();
+
+    if (colorSchemeVariant === "default" || !colorSchemeVariant) {
+        colorSchemeVariant = isDark ? styleVariant : '';
+    } else if (isDark) {
+        colorSchemeVariant = `${colorSchemeVariant}-${styleVariant}`;
+    }
+
+    if (colorSchemeVariant.length)
+        colorSchemeVariant = `-${colorSchemeVariant}`;
+    return _getStylesheet(`${baseThemeName}${colorSchemeVariant}.css`);
+}
+
 function _getDefaultStylesheet() {
     let stylesheet = null;
     let name = sessionMode.stylesheetName;
@@ -481,6 +526,9 @@ function _getDefaultStylesheet() {
     if (St.Settings.get().high_contrast)
         stylesheet = _getStylesheet(name.replace('.css', '-high-contrast.css'));
 
+    if (stylesheet == null && St.Settings.get().gtkTheme === 'Yaru')
+        stylesheet = _getYaruStyleSheet();
+
     if (stylesheet === null)
         stylesheet = _getStylesheet(name.replace('.css', `-${getStyleVariant()}.css`));
 
